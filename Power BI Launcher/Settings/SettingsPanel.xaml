<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PowerBILauncher.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerBILauncher">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scroller reaches the window edge; inner PageRightGutter keeps the overlay thumb off the form. -->
        <ScrollViewer
            x:Name="SettingsScroller"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid
                HorizontalAlignment="Stretch"
                Padding="{StaticResource PageRightGutter}">
        <StackPanel
            x:Name="SettingsFormPanel"
            MaxWidth="{StaticResource FormPageMaxWidth}"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock x:Name="SettingsTitle" x:Uid="SettingsTitle" Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <InfoBar
                x:Name="SetupVersionsInfoBar"
                x:Uid="SetupVersions"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Scan to register Power BI Desktop."
                Message="Scan, then pick, then confirm. Profiles cannot launch until a default version exists."
                Visibility="Collapsed"
                AutomationProperties.AutomationId="SetupVersionsInfoBar"/>

            <Border Padding="16" CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="RegisteredVersions" Text="Registered versions" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock
                                x:Uid="RegisteredVersionsHelp"
                                Text="Scan this PC or browse to a Power BI executable. One default version is used when a profile has not picked one."
                                Opacity="0.7"
                                TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="ScanVersionsButton"
                                Click="ScanVersionsButton_Click"
                                AutomationProperties.AutomationId="ScanVersionsButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16"/>
                                    <TextBlock x:Uid="Scan" Text="Scan"/>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BrowseVersionButton"
                                Click="BrowseVersionButton_Click"
                                AutomationProperties.AutomationId="BrowseVersionButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                    <TextBlock x:Uid="Browse" Text="Browse…"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="VersionsListView"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ContainerContentChanging="VersionsListView_ContainerContentChanging"
                        AutomationProperties.AutomationId="VersionsListView">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,8"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="IsTabStop" Value="True"/>
                                <Setter Property="TabNavigation" Value="Local"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VersionRegistryRow">
                                <!-- Trailing badges and the overflow button share one centred line; their
                                     left margins (not ColumnSpacing) keep collapsed badges at zero width. -->
                                <Grid AutomationProperties.Name="{x:Bind AutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind DisplayName}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Visibility="{x:Bind DisplayVisibility}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"/>
                                        <Grid
                                            ColumnSpacing="8"
                                            Visibility="{x:Bind EditVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                MinWidth="180"
                                                Text="{x:Bind DisplayName, Mode=OneTime}"
                                                KeyDown="VersionRenameBox_KeyDown"
                                                Loaded="VersionRenameBox_Loaded"
                                                Tag="{x:Bind Id}"/>
                                            <Button
                                                x:Uid="VersionRenameDone"
                                                Grid.Column="1"
                                                Padding="8"
                                                Click="VersionRenameDoneButton_Click"
                                                Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="Done (Enter)"
                                                AutomationProperties.Name="Confirm rename"
                                                AutomationProperties.AutomationId="{x:Bind ConfirmRenameAutomationId}">
                                                <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            Text="{x:Bind PathDisplay}"
                                            ToolTipService.ToolTip="{x:Bind PathTooltip}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Opacity="0.7"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind DefaultMarkerVisibility}"
                                        AutomationProperties.AccessibilityView="Raw">
                                        <TextBlock
                                            x:Uid="DefaultVersionBadge"
                                            Text="Default"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                    <!-- MinWidth keeps Desktop and Report Server badges the same width across rows. -->
                                    <Border
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        MinWidth="96"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind DisplayVisibility}"
                                        AutomationProperties.AccessibilityView="Raw">
                                        <TextBlock
                                            Text="{x:Bind KindBadgeText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <Button
                                        x:Uid="VersionMore"
                                        Grid.Column="3"
                                        Margin="8,0,0,0"
                                        Padding="8"
                                        VerticalAlignment="Center"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="{x:Bind RemoveTooltip}"
                                        AutomationProperties.Name="More actions"
                                        AutomationProperties.HelpText="{x:Bind RemoveTooltip}"
                                        AutomationProperties.AutomationId="{x:Bind MoreButtonAutomationId}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Uid="VersionRename"
                                                    Text="Rename"
                                                    Click="VersionRenameButton_Click"
                                                    Tag="{x:Bind Id}"
                                                    AutomationProperties.AutomationId="{x:Bind RenameMenuAutomationId}"/>
                                                <MenuFlyoutItem
                                                    x:Uid="VersionSetDefault"
                                                    Text="Set as default"
                                                    Visibility="{x:Bind SetDefaultVisibility}"
                                                    Click="VersionSetDefaultMenu_Click"
                                                    Tag="{x:Bind Id}"/>
                                                <MenuFlyoutItem
                                                    x:Uid="VersionRemove"
                                                    Text="Remove"
                                                    IsEnabled="{x:Bind CanRemove}"
                                                    ToolTipService.ToolTip="{x:Bind RemoveTooltip}"
                                                    AutomationProperties.HelpText="{x:Bind RemoveTooltip}"
                                                    Click="VersionRemoveMenu_Click"
                                                    Tag="{x:Bind Id}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xE712;" FontSize="16"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="VersionsEmptyText"
                        x:Uid="NoVersions"
                        Text="No versions registered."
                        Opacity="0.7"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="VersionsEmptyText"/>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Width="{StaticResource CardLabelColumnWidth}" Spacing="2">
                        <TextBlock x:Uid="FolderToStoreProfiles" Text="Folder to store profiles" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Uid="FolderToStoreProfilesHelp" Text="Root folder where profile data is stored." Opacity="0.7" TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="UserProfilePathErrorBorder"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="1">
                                <TextBox
                                    x:Name="UserProfilePathTextBox"
                                    AcceptsReturn="False"
                                    TextWrapping="NoWrap"
                                    IsSpellCheckEnabled="False"
                                    VerticalAlignment="Center"
                                    TextChanged="SettingsForm_TextChanged"
                                    AutomationProperties.AutomationId="UserProfilePathTextBox"/>
                            </Border>
                            <Button
                                x:Name="BrowseProfilesFolderButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="BrowseProfilesFolderButton_Click"
                                AutomationProperties.Name="Browse…"
                                AutomationProperties.AutomationId="BrowseProfilesFolderButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                                    <TextBlock x:Uid="Browse" Text="Browse…"/>
                                </StackPanel>
                            </Button>
                            <Grid
                                x:Name="OpenProfilesFolderTooltipHost"
                                Grid.Column="2"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="OpenProfilesFolderButton"
                                    IsEnabled="False"
                                    Click="OpenProfilesFolderButton_Click"
                                    AutomationProperties.Name="Open folder"
                                    AutomationProperties.AutomationId="OpenProfilesFolderButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                        <TextBlock x:Uid="OpenFolder" Text="Open folder"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                        <InfoBar
                            x:Name="ProfilesFolderIssueInfoBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Error"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="ProfilesFolderIssueInfoBar"/>
                        <TextBlock
                            x:Name="ProfilesFolderRootChangeNote"
                            x:Uid="ProfilesFolderRootChangeNote"
                            Text="Changing this folder does not move existing profile folders."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="ProfilesFolderRootChangeNote"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="16" CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Width="{StaticResource CardLabelColumnWidth}" Spacing="2">
                        <TextBlock x:Uid="MinimizeBehavior" Text="Minimize behavior" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Uid="MinimizeBehaviorHelp" Text="What the minimize button does" Opacity="0.7"/>
                    </StackPanel>
                    <ComboBox
                        x:Name="MinimizeBehaviorComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="SettingsForm_SelectionChanged"
                        AutomationProperties.AutomationId="MinimizeBehaviorComboBox">
                        <ComboBoxItem x:Uid="MinimizeToTaskbar" Content="Minimize to taskbar" Tag="Minimize" IsSelected="True"/>
                        <ComboBoxItem x:Uid="SendToTray" Content="Send to tray" Tag="SendToTray"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Padding="16" CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Width="{StaticResource CardLabelColumnWidth}" Spacing="2">
                        <TextBlock x:Uid="CloseBehavior" Text="Close behavior" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Uid="CloseBehaviorHelp" Text="What the close button does" Opacity="0.7"/>
                    </StackPanel>
                    <ComboBox
                        x:Name="CloseBehaviorComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="SettingsForm_SelectionChanged"
                        AutomationProperties.AutomationId="CloseBehaviorComboBox">
                        <ComboBoxItem x:Uid="ExitApplication" Content="Exit application" Tag="Close" IsSelected="True"/>
                        <ComboBoxItem x:Uid="SendToTray" Content="Send to tray" Tag="SendToTray"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Padding="16" CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="About"
                        Text="About"
                        Width="{StaticResource CardLabelColumnWidth}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="LauncherVersionTextBlock"
                                AutomationProperties.AutomationId="LauncherVersionText"/>
                            <TextBlock
                                x:Name="LauncherBuildDateTextBlock"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="LauncherBuildDateText"/>
                            <Button
                                x:Name="CheckForUpdatesButton"
                                x:Uid="CheckForUpdates"
                                Content="Check for updates"
                                HorizontalAlignment="Left"
                                Click="CheckForUpdatesButton_Click"
                                AutomationProperties.AutomationId="CheckForUpdatesButton"/>
                        </StackPanel>
                        <InfoBar
                            x:Name="AboutUpdateCheckInfoBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Informational"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="AboutUpdateCheckInfoBar">
                            <InfoBar.ActionButton>
                                <HyperlinkButton
                                    x:Name="AboutViewReleaseButton"
                                    x:Uid="ViewRelease"
                                    Content="View release"
                                    AutomationProperties.AutomationId="AboutViewReleaseButton"/>
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="BuiltBy" Text="Built by" VerticalAlignment="Center"/>
                            <HyperlinkButton
                                Content="booldata"
                                NavigateUri="https://booldata.com/"
                                Padding="0"
                                AutomationProperties.AutomationId="AboutBooldataLink"/>
                        </StackPanel>
                        <TextBlock
                            x:Uid="License"
                            Text="Licensed under the MIT License. © 2026 booldata"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
        <StackPanel x:Name="ScanStagingPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="ScanResults" Text="Scan results" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock
                x:Uid="ScanResultsHelp"
                Text="Tick the versions to register. Untick a previously discovered version to remove it."
                Opacity="0.7"
                TextWrapping="WrapWholeWords"/>
            <InfoBar
                x:Name="ScanStoreWarningInfoBar"
                x:Uid="ScanStoreWarning"
                IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Title="The Microsoft Store version is not supported."
                Message="It signs every profile in to the same account, so profiles cannot use it. Install the downloaded version of Power BI Desktop, then scan again."
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ScanStoreWarningInfoBar"/>
            <ListView
                x:Name="ScanResultsListView"
                SelectionMode="None"
                AutomationProperties.AutomationId="ScanResultsListView">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4,8"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ScanCandidateRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                IsEnabled="{x:Bind IsSupported}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind DisplayName}"/>
                            <StackPanel Grid.Column="1" Spacing="2" Opacity="{x:Bind RowOpacity}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind DisplayName}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock
                                        Text="{x:Bind local:AppChrome.KindLabel(Kind)}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.7"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind KindLabelVisibility}"/>
                                    <TextBlock
                                        x:Uid="ScanNotSupported"
                                        Text="Not supported"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind NotSupportedVisibility}"/>
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind Path}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.7"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="ScanEmptyText"
                x:Uid="ScanEmpty"
                Text="No Power BI executables were found. Browse to a Power BI executable instead."
                Opacity="0.7"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ScanEmptyText"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="ConfirmScanButton"
                    x:Uid="Confirm"
                    Content="Confirm"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ConfirmScanButton_Click"
                    AutomationProperties.AutomationId="ConfirmScanButton"/>
                <Button
                    x:Name="CancelScanButton"
                    x:Uid="Cancel"
                    Content="Cancel"
                    Click="CancelScanButton_Click"
                    AutomationProperties.AutomationId="CancelScanButton"/>
            </StackPanel>
        </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="SettingsFooter"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Padding="{StaticResource PageCommandFooterPadding}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                MaxWidth="{StaticResource FormPageMaxWidth}"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="SaveSettingsButton"
                    x:Uid="SaveSettings"
                    Content="Save settings"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="SaveSettingsButton_Click"
                    AutomationProperties.AutomationId="SaveSettingsButton"/>
                <Button
                    x:Name="CancelSettingsButton"
                    x:Uid="Cancel"
                    Content="Cancel"
                    Click="CancelSettingsButton_Click"
                    AutomationProperties.AutomationId="CancelSettingsButton"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
