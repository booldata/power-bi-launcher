<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>PowerBILauncher.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- VERSIONINFO must not contain "Power BI"; FileVersionInfoReaderTests uses this assembly as the negative fixture. -->
    <Product>Launcher tests</Product>
    <AssemblyTitle>Launcher tests</AssemblyTitle>
    <Description>Unit tests</Description>
    <IsPackable>false</IsPackable>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Power BI Launcher\Power BI Launcher.csproj" />
    <ProjectReference Include="..\Power BI Launcher.Tests.PbiDesktopFixture\Power BI Launcher.Tests.PbiDesktopFixture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
