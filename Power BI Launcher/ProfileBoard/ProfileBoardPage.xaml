<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PowerBILauncher.ProfileBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!-- Explicit Grid board: equal-width cards (max 5 cols). Overlay hosts Reorder gap indicator. -->
    <ScrollViewer
        x:Name="ProfileBoardScroller"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        XYFocusKeyboardNavigation="Enabled">
        <Grid
            x:Name="ProfileBoardRoot"
            HorizontalAlignment="Stretch"
            Padding="{StaticResource PageRightGutter}">
            <Grid x:Name="ProfileBoard" HorizontalAlignment="Stretch"/>
            <Canvas
                x:Name="ReorderInsertionLayer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>
            <StackPanel
                x:Name="EmptyBoardPanel"
                MaxWidth="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="EmptyBoardTitle"
                    x:Uid="EmptyBoardTitle"
                    Text="No profiles yet"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>
                <TextBlock
                    x:Name="EmptyBoardDescription"
                    x:Uid="EmptyBoardDescription"
                    Text="A profile is an isolated Power BI Desktop environment you can launch or edit."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>
                <Button
                    x:Name="EmptyBoardAddButton"
                    x:Uid="EmptyBoardAddButton"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="EmptyBoardAddButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock x:Uid="EmptyBoardAddProfile" Text="Add profile"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
