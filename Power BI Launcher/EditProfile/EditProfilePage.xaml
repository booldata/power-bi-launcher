<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PowerBILauncher.EditProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <!-- Horizontal scroll off: focusing the rename TextBox must not pan the page sideways. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Scroller reaches the window edge; inner PageRightGutter keeps the overlay thumb off the form. -->
        <ScrollViewer
            x:Name="EditProfileScroller"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid
                HorizontalAlignment="Stretch"
                Padding="{StaticResource PageRightGutter}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource FormPageMaxWidth}"/>
                </Grid.ColumnDefinitions>
        <StackPanel
            Spacing="{StaticResource SectionSpacing}"
            HorizontalAlignment="Stretch"
            Padding="0,0,0,16">

            <StackPanel Spacing="{StaticResource SectionTitleSpacing}">
                <TextBlock
                    x:Uid="EditProfileSection"
                    Text="Edit profile"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center"/>
                <Border
                    x:Name="IdentityLookCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="20">
                    <StackPanel Spacing="0">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Spacing="12"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Stretch">
                            <Grid
                                ColumnSpacing="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="NameHitButton"
                                    x:Uid="ProfileNamePencil"
                                    Background="{ThemeResource ControlFillColorTransparentBrush}"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalAlignment="Center"
                                    Click="RenameButton_Click"
                                    ToolTipService.ToolTip="Click to rename"
                                    AutomationProperties.Name="Profile name"
                                    AutomationProperties.AutomationId="ProfileNameDisplay">
                                    <TextBlock
                                        x:Name="NameDisplay"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"/>
                                </Button>

                                <Button
                                    x:Name="RenameButton"
                                    x:Uid="ProfileRename"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Padding="8"
                                    Click="RenameButton_Click"
                                    ToolTipService.ToolTip="Rename"
                                    AutomationProperties.Name="Rename"
                                    AutomationProperties.AutomationId="EditNameButton">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                                </Button>

                                <!-- While editing: Done / Discard replace the pencil. -->
                                <StackPanel
                                    x:Name="NameEditActions"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed">
                                    <Button
                                        x:Name="ConfirmNameButton"
                                        x:Uid="ProfileRenameDone"
                                        Padding="8"
                                        Click="ConfirmNameButton_Click"
                                        ToolTipService.ToolTip="Done (Enter)"
                                        AutomationProperties.Name="Confirm rename"
                                        AutomationProperties.AutomationId="ConfirmNameButton">
                                        <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                    </Button>
                                    <Button
                                        x:Name="CancelNameButton"
                                        x:Uid="ProfileRenameDiscard"
                                        Padding="8"
                                        Click="CancelNameButton_Click"
                                        ToolTipService.ToolTip="Discard (Esc)"
                                        AutomationProperties.Name="Discard rename"
                                        AutomationProperties.AutomationId="CancelNameButton">
                                        <FontIcon Glyph="&#xE711;" FontSize="16"/>
                                    </Button>
                                </StackPanel>

                                <TextBox
                                    x:Name="NameEditBox"
                                    x:Uid="ProfileNameBox"
                                    Grid.Column="0"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    TextWrapping="Wrap"
                                    PlaceholderText="Profile name"
                                    TextChanged="NameEditBox_TextChanged"
                                    KeyDown="NameEditBox_KeyDown"
                                    LostFocus="NameEditBox_LostFocus"
                                    AutomationProperties.AutomationId="ProfileNameTextBox"/>
                            </Grid>
                            <InfoBar
                                x:Name="ProfileNameIssueInfoBar"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Error"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="ProfileNameIssueInfoBar"/>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="ChangePhotoButton"
                                    Click="ChoosePhotoButton_Click"
                                    AutomationProperties.AutomationId="UploadPhotoButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE722;" FontSize="14"/>
                                        <TextBlock x:Name="ChangePhotoLabel" x:Uid="UploadIcon" Text="Upload icon"/>
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="RemovePhotoButton"
                                    Click="RemovePhotoButton_Click"
                                    PointerEntered="RemovePhotoButton_PointerEntered"
                                    PointerExited="RemovePhotoButton_PointerExited"
                                    PointerCaptureLost="RemovePhotoButton_PointerCaptureLost"
                                    GotFocus="RemovePhotoButton_GotFocus"
                                    LostFocus="RemovePhotoButton_LostFocus"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="RemovePhotoButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="RemovePhotoIcon" Glyph="&#xE74D;" FontSize="14"/>
                                        <TextBlock x:Name="RemovePhotoLabel" x:Uid="RemoveIcon" Text="Remove icon"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            </StackPanel>

                            <Border
                                x:Name="CardColorPreviewBorder"
                                Grid.Column="1"
                                Padding="12"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                AutomationProperties.Name="Card color preview"
                                AutomationProperties.AutomationId="CardColorPreviewBorder">
                                <Grid
                                    x:Name="AvatarPreviewHost"
                                    x:Uid="AvatarPreview"
                                    Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Avatar preview"
                                    AutomationProperties.AutomationId="AvatarPreviewHost">
                                    <Ellipse x:Name="IconPreviewEllipse" Width="72" Height="72"/>
                                    <TextBlock
                                        x:Name="IconPreviewLetter"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        TextWrapping="NoWrap"
                                        TextLineBounds="Tight"
                                        OpticalMarginAlignment="TrimSideBearings"
                                        UseLayoutRounding="False"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        AutomationProperties.AutomationId="AvatarPreviewLetter"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border
                            x:Name="AvatarColorPanel"
                            Margin="0,8,0,0"
                            Padding="0,16,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Glyph="&#xE77B;"
                                    FontSize="20"
                                    VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Uid="AvatarColor" Text="Avatar color" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock
                                        x:Uid="AvatarColorHelp"
                                        Text="Background color for the letter avatar."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.8"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <Button
                                    x:Name="PickAvatarColorButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="PickAvatarColorButton_Click"
                                    AutomationProperties.AutomationId="PickAvatarColorButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE790;" FontSize="14"/>
                                        <TextBlock x:Uid="PickAvatarColor" Text="Pick color"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border
                            Padding="0,16,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Glyph="&#xE790;"
                                    FontSize="20"
                                    VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Uid="CardColor" Text="Card color" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock
                                        x:Uid="CardColorHelp"
                                        Text="Accent tint on this profile’s board card."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.8"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="NoAccentButton"
                                        x:Uid="NoAccent"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Visibility="Collapsed"
                                        Click="NoAccentButton_Click"
                                        ToolTipService.ToolTip="Reset card color"
                                        AutomationProperties.Name="Reset card color"
                                        AutomationProperties.AutomationId="NoAccentButton">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                    <Button
                                        x:Name="PickCardColorButton"
                                        Click="PickCardColorButton_Click"
                                        AutomationProperties.AutomationId="PickCardColorButton">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="14"/>
                                            <TextBlock x:Uid="PickColor" Text="Pick color"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Launch - Version, Windows network identity, then tray. -->
            <StackPanel Spacing="{StaticResource SectionTitleSpacing}">
                <TextBlock x:Uid="LaunchSection" Text="Launch" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <InfoBar
                    x:Name="EmptyVersionInfoBar"
                    x:Uid="EmptyVersion"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Error"
                    Title="No versions registered."
                    Message="This profile cannot launch until a default version exists in settings."
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="EmptyVersionInfoBar">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="OpenSettings"
                            Content="Open settings"
                            Click="OpenSettingsButton_Click"
                            AutomationProperties.AutomationId="OpenSettingsFromLaunchButton"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    x:Name="DanglingVersionInfoBar"
                    x:Uid="DanglingVersion"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Error"
                    Title="This profile’s version is gone."
                    Message="It is no longer in the version registry. Pick another - launch will not fall back to the default version."
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="DanglingVersionInfoBar"/>
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="20">
                    <StackPanel Spacing="0">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="20"
                                VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Uid="VersionField" Text="Version" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <Button
                                        x:Name="VersionHelpButton"
                                        x:Uid="AboutVersion"
                                        Width="20"
                                        Height="20"
                                        MinWidth="20"
                                        Padding="0"
                                        Background="{ThemeResource ControlFillColorTransparentBrush}"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Leave on default version unless this profile needs another. Launch will not fall back if this version is gone."
                                        AutomationProperties.Name="About version"
                                        AutomationProperties.AutomationId="VersionHelpButton">
                                        <Border
                                            Width="18"
                                            Height="18"
                                            CornerRadius="9"
                                            BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                            BorderThickness="1">
                                            <TextBlock
                                                Text="i"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    x:Uid="VersionFieldHelp"
                                    Text="Power BI this profile launches."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.8"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <ComboBox
                                x:Name="VersionComboBox"
                                x:Uid="VersionCombo"
                                Grid.Column="2"
                                MinWidth="280"
                                MaxWidth="360"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Label"
                                SelectionChanged="VersionComboBox_SelectionChanged"
                                AutomationProperties.Name="Version"
                                AutomationProperties.AutomationId="VersionComboBox"/>
                        </Grid>
                        <InfoBar
                            x:Name="PasswordUnavailableInfoBar"
                            x:Uid="PasswordUnavailable"
                            Margin="0,16,0,0"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning"
                            Title="Saved password unavailable"
                            Message="Saved password unavailable on this Windows account or device. Launch is blocked until you save the password again. The current Windows user is not used as a fallback."
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="PasswordUnavailableInfoBar"/>
                        <Border
                            Padding="0,16,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <FontIcon
                                    Glyph="&#xE8D7;"
                                    FontSize="20"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            x:Uid="UseIdentity"
                                            Text="Use another Windows identity for network access"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"/>
                                        <Button
                                            x:Name="IdentityHelpButton"
                                            x:Uid="AboutIdentity"
                                            Width="20"
                                            Height="20"
                                            MinWidth="20"
                                            Padding="0"
                                            Background="{ThemeResource ControlFillColorTransparentBrush}"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Used when Power BI connects to Report Server or data sources that use Windows authentication. This does not sign you in to the Power BI service or replace your Entra ID/MFA sign-in."
                                            AutomationProperties.Name="About Windows network identity"
                                            AutomationProperties.AutomationId="IdentityHelpButton">
                                            <Border
                                                Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                BorderThickness="1">
                                                <TextBlock
                                                    Text="i"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        x:Uid="IdentityHelp"
                                        Text="Optional."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.8"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="IdentityToggle"
                                    x:Uid="IdentityToggle"
                                    Grid.Column="2"
                                    OnContent="On"
                                    OffContent="Off"
                                    VerticalAlignment="Center"
                                    Toggled="IdentityToggle_Toggled"
                                    AutomationProperties.Name="Use another Windows identity for network access"
                                    AutomationProperties.AutomationId="IdentityToggle"/>
                                <StackPanel
                                    x:Name="IdentityFieldsPanel"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <TextBox
                                        x:Name="IdentityTextBox"
                                        x:Uid="IdentityText"
                                        Header="Windows network identity"
                                        PlaceholderText="DOMAIN\user or user@domain"
                                        TextChanged="IdentityTextBox_TextChanged"
                                        AutomationProperties.AutomationId="IdentityTextBox"/>
                                    <StackPanel
                                        x:Name="PasswordSavedPanel"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                        <TextBlock x:Uid="PasswordSaved" Text="Password saved" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock
                                            x:Uid="PasswordSavedHelp"
                                            Text="Saved, not verified. Wrong or expired credentials show up when Power BI reaches the server."
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Opacity="0.8"
                                            TextWrapping="WrapWholeWords"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Uid="ReplacePassword"
                                                Content="Replace"
                                                Click="ReplacePasswordButton_Click"
                                                AutomationProperties.AutomationId="ReplacePasswordButton"/>
                                            <Button
                                                x:Uid="ClearIdentity"
                                                Content="Clear"
                                                Click="ClearIdentityButton_Click"
                                                AutomationProperties.AutomationId="ClearIdentityButton"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <PasswordBox
                                        x:Name="IdentityPasswordBox"
                                        x:Uid="IdentityPassword"
                                        Header="Password"
                                        PlaceholderText="Required to save this identity"
                                        PasswordChanged="IdentityFields_Changed"
                                        AutomationProperties.AutomationId="IdentityPasswordBox"/>
                                    <TextBlock
                                        x:Name="IdentityPasswordHelp"
                                        x:Uid="PasswordRequiredHelp"
                                        Text="Adding or changing the identity requires a password. Leave blank only to keep a saved one."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.8"
                                        TextWrapping="WrapWholeWords"/>
                                    <Button
                                        x:Name="CancelReplaceButton"
                                        x:Uid="KeepSavedPassword"
                                        Content="Keep saved password"
                                        Visibility="Collapsed"
                                        Click="CancelReplaceButton_Click"
                                        AutomationProperties.AutomationId="CancelReplaceButton"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Padding="0,16,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Glyph="&#xE7F4;"
                                    FontSize="20"
                                    VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            x:Uid="ShowOnTray"
                                            Text="Show profile in system tray"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"/>
                                        <Button
                                            x:Name="TrayHelpButton"
                                            x:Uid="AboutTray"
                                            Width="20"
                                            Height="20"
                                            MinWidth="20"
                                            Padding="0"
                                            Background="{ThemeResource ControlFillColorTransparentBrush}"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Off hides this profile from the tray. It remains on the board."
                                            AutomationProperties.Name="About show profile in system tray"
                                            AutomationProperties.AutomationId="TrayHelpButton">
                                            <Border
                                                Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                BorderThickness="1">
                                                <TextBlock
                                                    Text="i"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        x:Uid="ShowOnTrayHelp"
                                        Text="Quickly access this profile from the notification area."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.8"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ShowOnTrayToggle"
                                    x:Uid="ShowOnTrayToggle"
                                    Grid.Column="2"
                                    OnContent="On"
                                    OffContent="Off"
                                    VerticalAlignment="Center"
                                    Toggled="ShowOnTrayToggle_Toggled"
                                    AutomationProperties.Name="Show profile in system tray"
                                    AutomationProperties.AutomationId="ShowOnTrayToggle"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel
                x:Name="DraftExtrasPanel"
                Spacing="{StaticResource SectionSpacing}">
                <Border
                    x:Name="ProfileFolderPanel"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE8B7;"
                            FontSize="20"
                            VerticalAlignment="Center"/>
                        <StackPanel
                            Grid.Column="1"
                            MinWidth="0"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Uid="ProfileFolder"
                                Text="Profile folder"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="WrapWholeWords"/>
                            <TextBlock
                                x:Uid="ProfileFolderHelp"
                                Text="Contains all files and settings for this profile."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.8"
                                TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <Button
                            x:Name="OpenFolderButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OpenFolderButton_Click"
                            AutomationProperties.AutomationId="OpenFolderButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                <TextBlock x:Uid="OpenFolder" Text="Open folder"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid x:Name="DangerZonePanel" RowSpacing="{StaticResource SectionTitleSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="DangerZone" Text="Danger zone" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0"/>
                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Uid="DeleteHelp"
                                    Text="Delete this profile permanently."
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    TextWrapping="WrapWholeWords"/>
                                <TextBlock
                                    x:Uid="DeleteCannotUndo"
                                    Text="This action cannot be undone."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Opacity="0.9"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <Button
                                x:Name="DeleteProfileButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Click="DeleteProfileButton_Click"
                                AutomationProperties.AutomationId="DeleteProfileButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock x:Uid="DeleteProfile" Text="Delete profile"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Padding="{StaticResource PageCommandFooterPadding}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                MaxWidth="{StaticResource FormPageMaxWidth}"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="SaveButton"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="SaveButton_Click"
                    AutomationProperties.AutomationId="SaveProfileButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                        <TextBlock x:Uid="SaveChanges" Text="Save changes"/>
                    </StackPanel>
                </Button>
                <Button
                    x:Name="DiscardButton"
                    x:Uid="DiscardChanges"
                    Content="Discard"
                    Click="DiscardButton_Click"
                    AutomationProperties.AutomationId="DiscardProfileButton"/>
                <StackPanel
                    x:Name="UnsavedPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        x:Uid="UnsavedChanges"
                        Text="Unsaved changes"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
