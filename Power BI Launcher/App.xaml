<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PowerBILauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Keep PageGutter / FormPageMaxWidth / PagePadding / PageRightGutter in sync with WindowLayoutConstraints. -->
            <x:Double x:Key="PageGutter">32</x:Double>
            <x:Double x:Key="FormPageMaxWidth">800</x:Double>
            <x:Double x:Key="SectionSpacing">24</x:Double>
            <x:Double x:Key="SectionTitleSpacing">12</x:Double>
            <x:Double x:Key="CardLabelColumnWidth">240</x:Double>
            <Thickness x:Key="PagePadding">32,16,0,20</Thickness>
            <Thickness x:Key="PageRightGutter">0,0,32,0</Thickness>
            <Thickness x:Key="ShellNavPadding">32,12,32,0</Thickness>
            <Thickness x:Key="PageCommandFooterPadding">0,12,0,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
